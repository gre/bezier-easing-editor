{
  "name": "bezier-easing-editor",
  "version": "1.0.0",
  "description": "Cubic Bezier Curve editor made with React & SVG",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gre/bezier-easing-editor.git"
  },
  "keywords": [
    "react-component",
    "bezier-easing",
    "cubic-bezier",
    "easing",
    "editor"
  ],
  "author": "Gaëtan Renaudeau",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gre/bezier-easing-editor/issues"
  },
  "homepage": "https://github.com/gre/bezier-easing-editor",
  "dependencies": {
    "bezier-easing": "^2.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
